# ==============================================================================
# Synexora Root Environment Configuration Template
# Copy relevant blocks into frontend/.env.local, backend/server/.env, and backend/ai-service/.env
# ==============================================================================

# --- Backend Express Server (backend/server/.env) ---
PORT=8080
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/synexora
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
AI_SERVICE_URL=http://localhost:8000/api/v1
FASTAPI_URL=http://localhost:8000/api/v1
GROQ_API_KEY=your_groq_api_key_here

# --- Frontend Next.js (frontend/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=Synexora

# --- FastAPI AI Service (backend/ai-service/.env) ---
# PORT=8000
# HOST=0.0.0.0
# ENVIRONMENT=development
# BACKEND_API_URL=http://localhost:8080/api/v1
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
