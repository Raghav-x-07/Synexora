# Synexora Backend Server Environment Variables
PORT=8080
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/synexora

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here

# AI Service Connection
AI_SERVICE_URL=http://localhost:8000/api/v1
FASTAPI_URL=http://localhost:8000/api/v1

# Groq API / LLM Settings (Optional)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
